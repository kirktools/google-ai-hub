{
  "name": "google-ai-hub",
  "version": "1.0.7",
  "private": true,
  "description": "Google AI 权益与用量汇总看板（Chrome Manifest V3 扩展，纯本地运行、零外发、简体中文）",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.content.config.ts",
    "check": "pnpm typecheck && pnpm build",
    "package": "node scripts/package-release.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
